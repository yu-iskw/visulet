{
  "version": "0",
  "title": "Native Vega-Lite escape",
  "views": [
    {
      "id": "native-bar",
      "kind": "native",
      "renderer": "vega-lite",
      "spec": {
        "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
        "mark": "bar",
        "data": {
          "values": [
            {
              "quarter": "Q1",
              "revenue": 10
            },
            {
              "quarter": "Q2",
              "revenue": 20
            }
          ]
        },
        "encoding": {
          "x": {
            "field": "quarter",
            "type": "ordinal"
          },
          "y": {
            "field": "revenue",
            "type": "quantitative"
          }
        }
      }
    }
  ]
}
