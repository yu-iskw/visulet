{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignoreBinaries": ["grype"],
  "ignore": [".trunk/**"],
  "workspaces": {
    ".": {
      "entry": ["stylelint.config.mjs"],
      "project": ["**/*.{js,cjs,mjs,ts,cts,mts}", "!packages/**", "!.trunk/**", "!node_modules/**"]
    },
    "packages/*": {
      "project": ["src/**/*.ts"]
    },
    "packages/mcp-server": {
      "entry": ["src/index.ts", "src/vega-runtime.ts"],
      "project": ["src/**/*.ts", "scripts/**/*.mjs"]
    }
  }
}
