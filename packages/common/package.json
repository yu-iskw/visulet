{
  "name": "@visulet/core",
  "version": "0.1.0",
  "private": false,
  "license": "Apache-2.0",
  "description": "Vizulet VisualDocument v0 validation, diagnostics, catalog, rendering, and benchmark primitives.",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "src"
  ],
  "main": "dist/index.js",
