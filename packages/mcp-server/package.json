{
  "name": "@visulet/mcp-server",
  "version": "0.1.0",
  "private": false,
  "license": "Apache-2.0",
  "description": "MCP adapter for Vizulet deterministic visual operations.",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "src",
    "ui"
  ],
  "bin": {
    "visulet-mcp": "dist/index.js"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json"
  },
  "dependencies": {
    "@visulet/core": "workspace:*",
    "@visulet/renderer-mermaid": "workspace:*",
    "@visulet/renderer-vegalite": "workspace:*",
    "@visulet/schema": "workspace:*"
  }
}
