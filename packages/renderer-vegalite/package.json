{
  "name": "@visulet/renderer-vegalite",
  "version": "0.1.0",
  "private": false,
  "license": "Apache-2.0",
  "description": "Compile VisualDocument charts to Vega-Lite JSON.",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "src"
  ],
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json"
  },
  "dependencies": {
    "@visulet/core": "workspace:*"
  }
}
