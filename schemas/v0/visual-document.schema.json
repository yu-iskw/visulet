{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/yu-iskw/visually/main/schemas/v0/visual-document.schema.json",
  "title": "Visually VisualDocument v0",
  "description": "Canonical, renderer-neutral document model for charts, diagrams, infographics, tables, text, metrics, images, containers, and renderer-native escape hatches.",
  "type": "object",
  "required": ["version", "views"],
  "properties": {
    "$schema": { "type": "string", "format": "uri-reference" },
    "version": { "const": "0.1" },
    "metadata": { "$ref": "#/$defs/documentMetadata" },
    "data": {
      "type": "object",
      "propertyNames": { "$ref": "#/$defs/identifier" },
      "additionalProperties": { "$ref": "#/$defs/dataSource" }
    },
    "parameters": {
      "type": "object",
      "propertyNames": { "$ref": "#/$defs/identifier" },
      "additionalProperties": { "$ref": "#/$defs/parameterSpec" }
    },
    "theme": { "$ref": "#/$defs/themeRef" },
    "layout": { "$ref": "#/$defs/layoutSpec" },
    "views": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/view" } },
    "interactions": { "type": "array", "items": { "$ref": "#/$defs/interactionSpec" } },
    "extensions": {
      "type": "object",
      "description": "Namespaced extension payloads. Keys SHOULD be reverse-DNS or URI-like namespaces.",
      "additionalProperties": true
    }
  },
  "additionalProperties": false,
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9._:-]*$",
      "minLength": 1,
      "maxLength": 128
    },
    "jsonScalar": { "type": ["string", "number", "integer", "boolean", "null"] },
    "documentMetadata": {
      "type": "object",
      "properties": {
        "title": { "type": "string", "maxLength": 300 },
        "description": { "type": "string", "maxLength": 5000 },
        "language": { "type": "string", "maxLength": 64 },
        "tags": {
          "type": "array",
          "items": { "type": "string", "maxLength": 100 },
          "uniqueItems": true
        },
        "source": { "type": "string", "format": "uri-reference" },
        "createdBy": { "type": "string", "maxLength": 300 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" },
        "provenance": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["label"],
            "properties": {
              "label": { "type": "string", "maxLength": 300 },
              "uri": { "type": "string", "format": "uri-reference" },
              "note": { "type": "string", "maxLength": 2000 }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "inlineDataSource": {
      "type": "object",
      "required": ["values"],
      "properties": {
        "values": { "type": "array", "items": { "type": "object", "additionalProperties": true } },
        "schema": {
          "type": "object",
          "description": "Optional logical schema metadata for fields.",
          "additionalProperties": true
        }
      },
      "additionalProperties": false
    },
    "uriDataSource": {
      "type": "object",
      "required": ["uri", "format"],
      "properties": {
        "uri": { "type": "string", "format": "uri-reference" },
        "format": { "enum": ["json", "jsonl", "csv", "tsv", "yaml", "arrow", "parquet"] },
        "schema": { "type": "object", "additionalProperties": true },
        "options": { "type": "object", "additionalProperties": true }
      },
      "additionalProperties": false
    },
    "dataSource": {
      "oneOf": [{ "$ref": "#/$defs/inlineDataSource" }, { "$ref": "#/$defs/uriDataSource" }]
    },
    "parameterSpec": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": { "enum": ["string", "number", "integer", "boolean", "date", "datetime", "enum"] },
        "label": { "type": "string", "maxLength": 300 },
        "description": { "type": "string", "maxLength": 2000 },
        "default": { "$ref": "#/$defs/jsonScalar" },
        "values": { "type": "array", "items": { "$ref": "#/$defs/jsonScalar" } },
        "minimum": { "type": "number" },
        "maximum": { "type": "number" },
        "step": { "type": "number", "exclusiveMinimum": 0 }
      },
      "additionalProperties": false
    },
    "themeSpec": {
      "type": "object",
      "properties": {
        "extends": { "type": "string", "maxLength": 128 },
        "fontFamily": { "type": "string", "maxLength": 300 },
        "foreground": { "type": "string", "maxLength": 100 },
        "background": { "type": "string", "maxLength": 100 },
        "accent": { "type": "string", "maxLength": 100 },
        "categorical": {
          "type": "array",
          "items": { "type": "string", "maxLength": 100 },
          "minItems": 1
        },
        "positive": { "type": "string", "maxLength": 100 },
        "negative": { "type": "string", "maxLength": 100 },
        "muted": { "type": "string", "maxLength": 100 },
        "spacing": { "type": "number", "minimum": 0 },
        "cornerRadius": { "type": "number", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "themeRef": {
      "oneOf": [
        { "type": "string", "minLength": 1, "maxLength": 128 },
        { "$ref": "#/$defs/themeSpec" }
      ]
    },
    "layoutSpec": {
      "type": "object",
      "properties": {
        "type": { "enum": ["grid", "stack", "flow"] },
        "columns": { "type": "integer", "minimum": 1, "maximum": 48 },
        "gap": { "type": "number", "minimum": 0 },
        "padding": { "type": "number", "minimum": 0 },
        "width": { "oneOf": [{ "type": "number", "exclusiveMinimum": 0 }, { "const": "auto" }] },
        "height": { "oneOf": [{ "type": "number", "exclusiveMinimum": 0 }, { "const": "auto" }] }
      },
      "additionalProperties": false
    },
    "placementSpec": {
      "type": "object",
      "properties": {
        "column": { "type": "integer", "minimum": 1 },
        "row": { "type": "integer", "minimum": 1 },
        "columnSpan": { "type": "integer", "minimum": 1 },
        "rowSpan": { "type": "integer", "minimum": 1 },
        "order": { "type": "integer" },
        "width": {
          "oneOf": [
            { "type": "number", "exclusiveMinimum": 0 },
            { "const": "auto" },
            { "type": "string", "pattern": "^[0-9]+(?:\\.[0-9]+)?%$" }
          ]
        },
        "height": {
          "oneOf": [
            { "type": "number", "exclusiveMinimum": 0 },
            { "const": "auto" },
            { "type": "string", "pattern": "^[0-9]+(?:\\.[0-9]+)?%$" }
          ]
        }
      },
      "additionalProperties": false
    },
    "accessibilitySpec": {
      "type": "object",
      "properties": {
        "label": { "type": "string", "maxLength": 500 },
        "description": { "type": "string", "maxLength": 5000 },
        "summary": { "type": "string", "maxLength": 5000 },
        "hidden": { "type": "boolean", "default": false }
      },
      "additionalProperties": false
    },
    "viewBase": {
      "type": "object",
      "required": ["id", "kind"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "kind": { "type": "string" },
        "title": { "type": "string", "maxLength": 300 },
        "description": { "type": "string", "maxLength": 5000 },
        "data": { "$ref": "#/$defs/identifier" },
        "theme": { "$ref": "#/$defs/themeRef" },
        "placement": { "$ref": "#/$defs/placementSpec" },
        "accessibility": { "$ref": "#/$defs/accessibilitySpec" },
        "extensions": { "type": "object", "additionalProperties": true }
      }
    },
    "fieldEncoding": {
      "type": "object",
      "required": ["field"],
      "properties": {
        "field": { "type": "string", "minLength": 1, "maxLength": 300 },
        "fieldType": { "enum": ["nominal", "ordinal", "quantitative", "temporal", "geographic"] },
        "semanticType": { "type": "string", "minLength": 1, "maxLength": 128 },
        "unit": { "type": "string", "maxLength": 64 },
        "aggregate": { "enum": ["count", "sum", "mean", "median", "min", "max", "distinct"] },
        "bin": {
          "oneOf": [
            { "type": "boolean" },
            {
              "type": "object",
              "properties": { "maxBins": { "type": "integer", "minimum": 2 } },
              "additionalProperties": false
            }
          ]
        },
        "timeUnit": {
          "enum": [
            "year",
            "quarter",
            "month",
            "week",
            "date",
            "day",
            "hours",
            "minutes",
            "seconds",
            "yearmonth",
            "yearmonthdate"
          ]
        },
        "sort": {
          "oneOf": [
            { "enum": ["ascending", "descending"] },
            { "type": "array", "items": { "$ref": "#/$defs/jsonScalar" } }
          ]
        },
        "title": { "type": "string", "maxLength": 300 },
        "format": { "type": "string", "maxLength": 128 }
      },
      "additionalProperties": false
    },
    "encodingSpec": {
      "type": "object",
      "properties": {
        "x": { "$ref": "#/$defs/fieldEncoding" },
        "y": { "$ref": "#/$defs/fieldEncoding" },
        "color": { "$ref": "#/$defs/fieldEncoding" },
        "size": { "$ref": "#/$defs/fieldEncoding" },
        "shape": { "$ref": "#/$defs/fieldEncoding" },
        "detail": { "$ref": "#/$defs/fieldEncoding" },
        "row": { "$ref": "#/$defs/fieldEncoding" },
        "column": { "$ref": "#/$defs/fieldEncoding" },
        "theta": { "$ref": "#/$defs/fieldEncoding" },
        "radius": { "$ref": "#/$defs/fieldEncoding" },
        "tooltip": {
          "oneOf": [
            { "$ref": "#/$defs/fieldEncoding" },
            { "type": "array", "items": { "$ref": "#/$defs/fieldEncoding" } }
          ]
        }
      },
      "additionalProperties": false,
      "minProperties": 1
    },
    "chartView": {
      "allOf": [
        { "$ref": "#/$defs/viewBase" },
        {
          "type": "object",
          "required": ["chart", "encoding"],
          "properties": {
            "kind": { "const": "chart" },
            "chart": {
              "enum": [
                "bar",
                "grouped-bar",
                "stacked-bar",
                "diverging-bar",
                "line",
                "area",
                "scatter",
                "bubble",
                "histogram",
                "box-plot",
                "heatmap",
                "calendar-heatmap"
              ]
            },
            "encoding": { "$ref": "#/$defs/encodingSpec" },
            "options": { "$ref": "#/$defs/chartOptions" }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "diagramNode": {
      "type": "object",
      "required": ["id"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "label": { "type": "string", "maxLength": 500 },
        "type": { "type": "string", "maxLength": 128 },
        "parent": { "$ref": "#/$defs/identifier" },
        "metadata": { "type": "object", "additionalProperties": true }
      },
      "additionalProperties": false
    },
    "diagramEdge": {
      "type": "object",
      "required": ["from", "to"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "from": { "$ref": "#/$defs/identifier" },
        "to": { "$ref": "#/$defs/identifier" },
        "label": { "type": "string", "maxLength": 500 },
        "type": { "type": "string", "maxLength": 128 },
        "directed": { "type": "boolean", "default": true },
        "metadata": { "type": "object", "additionalProperties": true }
      },
      "additionalProperties": false
    },
    "graphDiagramModel": {
      "type": "object",
      "required": ["nodes"],
      "properties": {
        "nodes": { "type": "array", "items": { "$ref": "#/$defs/diagramNode" } },
        "edges": { "type": "array", "items": { "$ref": "#/$defs/diagramEdge" } },
        "direction": { "enum": ["top-down", "bottom-up", "left-right", "right-left", "auto"] }
      },
      "additionalProperties": false
    },
    "sequenceDiagramModel": {
      "type": "object",
      "required": ["participants", "messages"],
      "properties": {
        "participants": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["id"],
            "properties": {
              "id": { "$ref": "#/$defs/identifier" },
              "label": { "type": "string", "maxLength": 500 },
              "type": { "type": "string", "maxLength": 128 }
            },
            "additionalProperties": false
          }
        },
        "messages": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["from", "to", "label"],
            "properties": {
              "from": { "$ref": "#/$defs/identifier" },
              "to": { "$ref": "#/$defs/identifier" },
              "label": { "type": "string", "maxLength": 1000 },
              "type": { "enum": ["sync", "async", "return", "create", "destroy", "note"] }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "timelineDiagramModel": {
      "type": "object",
      "required": ["items"],
      "properties": {
        "items": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["label"],
            "properties": {
              "id": { "$ref": "#/$defs/identifier" },
              "label": { "type": "string", "maxLength": 500 },
              "time": { "type": "string", "maxLength": 128 },
              "description": { "type": "string", "maxLength": 2000 },
              "group": { "type": "string", "maxLength": 128 }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "ganttDiagramModel": {
      "type": "object",
      "required": ["tasks"],
      "properties": {
        "tasks": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "label"],
            "properties": {
              "id": { "$ref": "#/$defs/identifier" },
              "label": { "type": "string", "maxLength": 500 },
              "start": { "type": "string", "maxLength": 128 },
              "end": { "type": "string", "maxLength": 128 },
              "duration": { "type": "string", "maxLength": 128 },
              "dependsOn": { "type": "array", "items": { "$ref": "#/$defs/identifier" } },
              "group": { "type": "string", "maxLength": 128 },
              "progress": { "type": "number", "minimum": 0, "maximum": 1 }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "diagramModel": {
      "oneOf": [
        { "$ref": "#/$defs/graphDiagramModel" },
        { "$ref": "#/$defs/sequenceDiagramModel" },
        { "$ref": "#/$defs/timelineDiagramModel" },
        { "$ref": "#/$defs/ganttDiagramModel" }
      ]
    },
    "diagramView": {
      "allOf": [
        { "$ref": "#/$defs/viewBase" },
        {
          "type": "object",
          "required": ["diagram", "model"],
          "properties": {
            "kind": { "const": "diagram" },
            "diagram": {
              "enum": [
                "flow",
                "sequence",
                "state",
                "er",
                "class",
                "architecture",
                "tree",
                "mind-map",
                "timeline",
                "gantt"
              ]
            },
            "model": { "$ref": "#/$defs/diagramModel" },
            "options": { "$ref": "#/$defs/diagramOptions" }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "infographicItem": {
      "type": "object",
      "required": ["id"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "label": { "type": "string", "maxLength": 500 },
        "description": { "type": "string", "maxLength": 3000 },
        "value": { "$ref": "#/$defs/jsonScalar" },
        "unit": { "type": "string", "maxLength": 64 },
        "icon": { "type": "string", "maxLength": 300 },
        "image": { "type": "string", "format": "uri-reference" },
        "group": { "type": "string", "maxLength": 128 },
        "children": { "type": "array", "items": { "$ref": "#/$defs/infographicItem" } }
      },
      "additionalProperties": false
    },
    "infographicLink": {
      "type": "object",
      "required": ["from", "to"],
      "properties": {
        "from": { "$ref": "#/$defs/identifier" },
        "to": { "$ref": "#/$defs/identifier" },
        "label": { "type": "string", "maxLength": 500 }
      },
      "additionalProperties": false
    },
    "infographicView": {
      "allOf": [
        { "$ref": "#/$defs/viewBase" },
        {
          "type": "object",
          "required": ["infographic", "items"],
          "properties": {
            "kind": { "const": "infographic" },
            "infographic": {
              "enum": [
                "list",
                "steps",
                "process",
                "comparison",
                "before-after",
                "hierarchy",
                "timeline",
                "cycle",
                "statistic-cards",
                "matrix"
              ]
            },
            "items": {
              "type": "array",
              "minItems": 1,
              "items": { "$ref": "#/$defs/infographicItem" }
            },
            "links": { "type": "array", "items": { "$ref": "#/$defs/infographicLink" } },
            "options": { "$ref": "#/$defs/infographicOptions" }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "conditionalFormat": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": { "enum": ["heatmap", "data-bar", "color-scale"] },
        "min": { "type": "number" },
        "max": { "type": "number" },
        "format": { "type": "string", "maxLength": 128 }
      },
      "additionalProperties": false
    },
    "tableView": {
      "allOf": [
        { "$ref": "#/$defs/viewBase" },
        {
          "type": "object",
          "required": ["columns"],
          "properties": {
            "kind": { "const": "table" },
            "columns": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "required": ["field"],
                "properties": {
                  "field": { "type": "string", "minLength": 1, "maxLength": 300 },
                  "label": { "type": "string", "maxLength": 300 },
                  "format": { "type": "string", "maxLength": 128 },
                  "sortable": { "type": "boolean", "default": true },
                  "visible": { "type": "boolean", "default": true },
                  "conditionalFormat": { "$ref": "#/$defs/conditionalFormat" }
                },
                "additionalProperties": false
              }
            },
            "sort": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["field", "direction"],
                "properties": {
                  "field": { "type": "string", "minLength": 1, "maxLength": 300 },
                  "direction": { "enum": ["ascending", "descending"] }
                },
                "additionalProperties": false
              }
            },
            "pageSize": { "type": "integer", "minimum": 1, "maximum": 10000 },
            "selectable": { "type": "boolean", "default": false },
            "mode": { "enum": ["table", "pivot"] },
            "pivot": { "$ref": "#/$defs/pivotSpec" },
            "columnSelection": { "type": "boolean", "default": false }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "textView": {
      "allOf": [
        { "$ref": "#/$defs/viewBase" },
        {
          "type": "object",
          "required": ["markdown"],
          "properties": {
            "kind": { "const": "text" },
            "markdown": { "type": "string", "maxLength": 200000 }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "metricValueRef": {
      "type": "object",
      "required": ["field"],
      "properties": {
        "field": { "type": "string", "minLength": 1, "maxLength": 300 },
        "aggregate": { "enum": ["count", "sum", "mean", "median", "min", "max", "distinct"] }
      },
      "additionalProperties": false
    },
    "metricView": {
      "allOf": [
        { "$ref": "#/$defs/viewBase" },
        {
          "type": "object",
          "required": ["value"],
          "properties": {
            "kind": { "const": "metric" },
            "label": { "type": "string", "maxLength": 300 },
            "value": {
              "oneOf": [{ "$ref": "#/$defs/jsonScalar" }, { "$ref": "#/$defs/metricValueRef" }]
            },
            "format": { "type": "string", "maxLength": 128 },
            "unit": { "type": "string", "maxLength": 64 }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "imageView": {
      "allOf": [
        { "$ref": "#/$defs/viewBase" },
        {
          "type": "object",
          "required": ["uri", "alt"],
          "properties": {
            "kind": { "const": "image" },
            "uri": { "type": "string", "format": "uri-reference" },
            "alt": { "type": "string", "maxLength": 2000 },
            "fit": { "enum": ["contain", "cover", "fill", "none"] }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "containerView": {
      "allOf": [
        { "$ref": "#/$defs/viewBase" },
        {
          "type": "object",
          "required": ["layout", "children"],
          "properties": {
            "kind": { "const": "container" },
            "layout": { "$ref": "#/$defs/layoutSpec" },
            "children": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/view" } }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "nativeView": {
      "allOf": [
        { "$ref": "#/$defs/viewBase" },
        {
          "type": "object",
          "required": ["renderer", "spec"],
          "properties": {
            "kind": { "const": "native" },
            "renderer": { "type": "string", "minLength": 1, "maxLength": 128 },
            "spec": { "type": "object", "additionalProperties": true }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "view": {
      "oneOf": [
        { "$ref": "#/$defs/chartView" },
        { "$ref": "#/$defs/diagramView" },
        { "$ref": "#/$defs/infographicView" },
        { "$ref": "#/$defs/tableView" },
        { "$ref": "#/$defs/textView" },
        { "$ref": "#/$defs/metricView" },
        { "$ref": "#/$defs/imageView" },
        { "$ref": "#/$defs/containerView" },
        { "$ref": "#/$defs/nativeView" }
      ]
    },
    "interactionSpec": {
      "type": "object",
      "required": ["type", "source"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "type": {
          "enum": [
            "select",
            "hover",
            "filter",
            "highlight",
            "zoom",
            "pan",
            "drilldown",
            "parameter"
          ]
        },
        "source": { "$ref": "#/$defs/identifier" },
        "field": { "type": "string", "maxLength": 300 },
        "targets": {
          "type": "array",
          "items": { "$ref": "#/$defs/identifier" },
          "uniqueItems": true
        },
        "parameter": { "$ref": "#/$defs/identifier" }
      },
      "additionalProperties": false
    },
    "chartOptions": {
      "type": "object",
      "properties": {
        "orientation": { "enum": ["horizontal", "vertical", "auto"] },
        "normalize": { "type": "boolean" },
        "zeroBaseline": { "type": "boolean" },
        "showLegend": { "type": "boolean" },
        "showLabels": { "type": "boolean" },
        "interpolation": { "enum": ["linear", "step", "monotone"] }
      },
      "additionalProperties": false
    },
    "diagramOptions": {
      "type": "object",
      "properties": {
        "direction": { "enum": ["top-down", "bottom-up", "left-right", "right-left", "auto"] }
      },
      "additionalProperties": false
    },
    "infographicOptions": {
      "type": "object",
      "properties": {
        "direction": { "enum": ["vertical", "horizontal", "radial", "auto"] },
        "emphasis": { "enum": ["balanced", "data", "narrative"] }
      },
      "additionalProperties": false
    },
    "pivotValue": {
      "type": "object",
      "required": ["field", "aggregate"],
      "properties": {
        "field": { "type": "string", "minLength": 1, "maxLength": 300 },
        "aggregate": { "enum": ["count", "sum", "mean", "median", "min", "max", "distinct"] },
        "label": { "type": "string", "maxLength": 300 },
        "format": { "type": "string", "maxLength": 128 }
      },
      "additionalProperties": false
    },
    "pivotSpec": {
      "type": "object",
      "required": ["rows", "values"],
      "properties": {
        "rows": {
          "type": "array",
          "items": { "type": "string", "minLength": 1, "maxLength": 300 },
          "minItems": 1
        },
        "columns": {
          "type": "array",
          "items": { "type": "string", "minLength": 1, "maxLength": 300 }
        },
        "values": { "type": "array", "items": { "$ref": "#/$defs/pivotValue" }, "minItems": 1 },
        "showTotals": { "type": "boolean", "default": true }
      },
      "additionalProperties": false
    }
  }
}
