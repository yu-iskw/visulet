{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://visulet.dev/schema/v0/visual-document.schema.json",
  "title": "Vizulet VisualDocument v0",
  "type": "object",
  "required": ["version", "views"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string", "format": "uri-reference" },
    "version": { "const": "0" },
    "title": { "type": "string" },
    "description": { "type": "string" },
    "metadata": { "$ref": "#/$defs/metadata" },
    "data": {
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/dataSource" }
    },
    "theme": { "$ref": "#/$defs/themeRef" },
    "parameters": {
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/parameter" }
    },
    "layout": { "$ref": "#/$defs/layout" },
    "views": {
      "type": "array",
      "items": { "$ref": "#/$defs/view" }
    },
    "interactions": {
      "type": "array",
      "items": { "$ref": "#/$defs/interaction" }
    },
    "security": { "$ref": "#/$defs/security" },
    "extensions": { "$ref": "#/$defs/extensions" }
  },
  "$defs": {
    "extensions": {
      "type": "object",
      "description": "Namespaced extension properties.",
      "additionalProperties": true
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "createdBy": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" },
        "source": { "type": "string" },
        "license": { "type": "string" },
        "provenance": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["kind"],
            "additionalProperties": false,
            "properties": {
              "kind": { "enum": ["user", "agent", "tool", "dataset", "import"] },
              "name": { "type": "string" },
              "uri": { "type": "string", "format": "uri-reference" },
              "timestamp": { "type": "string", "format": "date-time" }
            }
          }
        },
        "extensions": { "$ref": "#/$defs/extensions" }
      }
    },
    "dataSource": {
      "oneOf": [
        {
          "type": "object",
          "required": ["values"],
          "additionalProperties": false,
          "properties": {
            "values": {
              "type": "array",
              "items": { "type": "object", "additionalProperties": true }
            },
            "schema": { "$ref": "#/$defs/dataSchema" },
            "extensions": { "$ref": "#/$defs/extensions" }
          }
        },
        {
          "type": "object",
          "required": ["uri", "format"],
          "additionalProperties": false,
          "properties": {
            "uri": { "type": "string", "format": "uri-reference" },
            "format": { "enum": ["json", "jsonl", "csv", "tsv", "arrow", "parquet"] },
            "schema": { "$ref": "#/$defs/dataSchema" },
            "options": { "type": "object", "additionalProperties": true },
            "integrity": { "type": "string" },
            "extensions": { "$ref": "#/$defs/extensions" }
          }
        }
      ]
    },
    "dataSchema": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "fields": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name"],
            "additionalProperties": false,
            "properties": {
              "name": { "type": "string" },
              "type": {
                "enum": [
                  "string",
                  "integer",
                  "number",
                  "boolean",
                  "date",
                  "datetime",
                  "duration",
                  "object",
                  "array"
                ]
              },
              "semanticType": { "type": "string" },
              "unit": { "type": "string" },
              "nullable": { "type": "boolean", "default": true },
              "description": { "type": "string" },
              "extensions": { "$ref": "#/$defs/extensions" }
            }
          }
        },
        "primaryKey": {
          "type": "array",
          "items": { "type": "string" },
          "uniqueItems": true
        },
        "extensions": { "$ref": "#/$defs/extensions" }
      }
    },
    "themeRef": {
      "oneOf": [{ "type": "string" }, { "$ref": "#/$defs/theme" }]
    },
    "theme": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string" },
        "extends": { "type": "string" },
        "typography": { "type": "object", "additionalProperties": true },
        "palette": { "type": "object", "additionalProperties": true },
        "spacing": { "type": "object", "additionalProperties": true },
        "surface": { "type": "object", "additionalProperties": true },
        "extensions": { "$ref": "#/$defs/extensions" }
      }
    },
    "parameter": {
      "type": "object",
      "required": ["type"],
      "additionalProperties": false,
      "properties": {
        "type": {
          "enum": ["string", "number", "integer", "boolean", "date", "datetime", "enum"]
        },
        "value": true,
        "default": true,
        "enum": { "type": "array" },
        "label": { "type": "string" },
        "description": { "type": "string" },
        "extensions": { "$ref": "#/$defs/extensions" }
      }
    },
    "layout": {
      "oneOf": [
        {
          "type": "object",
          "required": ["type"],
          "additionalProperties": false,
          "properties": {
            "type": { "const": "grid" },
            "columns": { "type": "integer", "minimum": 1, "maximum": 48, "default": 12 },
            "gap": { "type": ["number", "string"] },
            "rowHeight": { "type": ["number", "string"] },
            "extensions": { "$ref": "#/$defs/extensions" }
          }
        },
        {
          "type": "object",
          "required": ["type"],
          "additionalProperties": false,
          "properties": {
            "type": { "enum": ["flow", "stack"] },
            "direction": { "enum": ["row", "column"] },
            "gap": { "type": ["number", "string"] },
            "extensions": { "$ref": "#/$defs/extensions" }
          }
        }
      ]
    },
    "placement": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "column": { "type": "integer", "minimum": 1 },
        "row": { "type": "integer", "minimum": 1 },
        "span": { "type": "integer", "minimum": 1 },
        "rowSpan": { "type": "integer", "minimum": 1 },
        "width": { "type": ["number", "string"] },
        "height": { "type": ["number", "string"] },
        "extensions": { "$ref": "#/$defs/extensions" }
      }
    },
    "accessibility": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "label": { "type": "string" },
        "description": { "type": "string" },
        "longDescription": { "type": "string" },
        "decorative": { "type": "boolean" },
        "extensions": { "$ref": "#/$defs/extensions" }
      }
    },
    "rendererPreference": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "preferred": { "type": "string" },
        "fallbacks": {
          "type": "array",
          "items": { "type": "string" },
          "uniqueItems": true
        },
        "requireCapabilities": {
          "type": "array",
          "items": { "type": "string" },
          "uniqueItems": true
        },
        "extensions": { "$ref": "#/$defs/extensions" }
      }
    },
    "fieldRef": {
      "type": "object",
      "required": ["field"],
      "additionalProperties": false,
      "properties": {
        "field": { "type": "string" },
        "type": { "enum": ["nominal", "ordinal", "quantitative", "temporal", "geographic"] },
        "semanticType": { "type": "string" },
        "unit": { "type": "string" },
        "aggregate": { "type": "string" },
        "format": { "type": "string" },
        "sort": {
          "oneOf": [{ "enum": ["ascending", "descending"] }, { "type": "array" }]
        },
        "extensions": { "$ref": "#/$defs/extensions" }
      }
    },
    "view": {
      "oneOf": [
        { "$ref": "#/$defs/chart" },
        { "$ref": "#/$defs/diagram" },
        { "$ref": "#/$defs/infographic" },
        { "$ref": "#/$defs/table" },
        { "$ref": "#/$defs/text" },
        { "$ref": "#/$defs/metric" },
        { "$ref": "#/$defs/container" },
        { "$ref": "#/$defs/native" }
      ]
    },
    "chart": {
      "type": "object",
      "required": ["id", "kind", "chart", "data", "encoding"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "kind": { "const": "chart" },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "chart": { "type": "string", "minLength": 1 },
        "data": { "type": "string", "minLength": 1 },
        "encoding": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/fieldRef" }
        },
        "transforms": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["type"],
            "properties": {
              "type": {
                "enum": [
                  "filter",
                  "calculate",
                  "aggregate",
                  "window",
                  "bin",
                  "fold",
                  "pivot",
                  "sample",
                  "sort",
                  "limit"
                ]
              }
            },
            "additionalProperties": true
          }
        },
        "options": { "type": "object", "additionalProperties": true },
        "renderer": { "$ref": "#/$defs/rendererPreference" },
        "theme": { "$ref": "#/$defs/themeRef" },
        "placement": { "$ref": "#/$defs/placement" },
        "accessibility": { "$ref": "#/$defs/accessibility" },
        "extensions": { "$ref": "#/$defs/extensions" }
      }
    },
    "node": {
      "type": "object",
      "required": ["id"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string" },
        "label": { "type": "string" },
        "type": { "type": "string" },
        "group": { "type": "string" },
        "data": { "type": "object", "additionalProperties": true },
        "extensions": { "$ref": "#/$defs/extensions" }
      }
    },
    "edge": {
      "type": "object",
      "required": ["from", "to"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string" },
        "from": { "type": "string" },
        "to": { "type": "string" },
        "label": { "type": "string" },
        "type": { "type": "string" },
        "data": { "type": "object", "additionalProperties": true },
        "extensions": { "$ref": "#/$defs/extensions" }
      }
    },
    "diagram": {
      "type": "object",
      "required": ["id", "kind", "diagram"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "kind": { "const": "diagram" },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "diagram": { "type": "string", "minLength": 1 },
        "nodes": {
          "type": "array",
          "items": { "$ref": "#/$defs/node" }
        },
        "edges": {
          "type": "array",
          "items": { "$ref": "#/$defs/edge" }
        },
        "model": { "type": "object", "additionalProperties": true },
        "direction": { "enum": ["top-down", "bottom-up", "left-right", "right-left"] },
        "options": { "type": "object", "additionalProperties": true },
        "renderer": { "$ref": "#/$defs/rendererPreference" },
        "theme": { "$ref": "#/$defs/themeRef" },
        "placement": { "$ref": "#/$defs/placement" },
        "accessibility": { "$ref": "#/$defs/accessibility" },
        "extensions": { "$ref": "#/$defs/extensions" }
      },
      "anyOf": [{ "required": ["nodes"] }, { "required": ["model"] }]
    },
    "infographicItem": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string" },
        "label": { "type": "string" },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "value": true,
        "icon": { "type": "string" },
        "image": { "type": "string", "format": "uri-reference" },
        "children": {
          "type": "array",
          "items": { "$ref": "#/$defs/infographicItem" }
        },
        "data": { "type": "object", "additionalProperties": true },
        "extensions": { "$ref": "#/$defs/extensions" }
      }
    },
    "infographic": {
      "type": "object",
      "required": ["id", "kind", "structure", "items"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "kind": { "const": "infographic" },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "structure": { "type": "string", "minLength": 1 },
        "items": {
          "type": "array",
          "items": { "$ref": "#/$defs/infographicItem" }
        },
        "options": { "type": "object", "additionalProperties": true },
        "renderer": { "$ref": "#/$defs/rendererPreference" },
        "theme": { "$ref": "#/$defs/themeRef" },
        "placement": { "$ref": "#/$defs/placement" },
        "accessibility": { "$ref": "#/$defs/accessibility" },
        "extensions": { "$ref": "#/$defs/extensions" }
      }
    },
    "table": {
      "type": "object",
      "required": ["id", "kind", "data"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "kind": { "const": "table" },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "data": { "type": "string" },
        "columns": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["field"],
            "additionalProperties": false,
            "properties": {
              "field": { "type": "string" },
              "label": { "type": "string" },
              "format": { "type": "string" },
              "width": { "type": ["number", "string"] },
              "sortable": { "type": "boolean" },
              "hidden": { "type": "boolean" },
              "heatmap": { "type": "boolean" },
              "extensions": { "$ref": "#/$defs/extensions" }
            }
          }
        },
        "sort": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["field", "order"],
            "additionalProperties": false,
            "properties": {
              "field": { "type": "string" },
              "order": { "enum": ["ascending", "descending"] }
            }
          }
        },
        "pageSize": { "type": "integer", "minimum": 1 },
        "options": { "type": "object", "additionalProperties": true },
        "theme": { "$ref": "#/$defs/themeRef" },
        "placement": { "$ref": "#/$defs/placement" },
        "accessibility": { "$ref": "#/$defs/accessibility" },
        "extensions": { "$ref": "#/$defs/extensions" }
      }
    },
    "text": {
      "type": "object",
      "required": ["id", "kind", "markdown"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "kind": { "const": "text" },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "markdown": { "type": "string" },
        "theme": { "$ref": "#/$defs/themeRef" },
        "placement": { "$ref": "#/$defs/placement" },
        "accessibility": { "$ref": "#/$defs/accessibility" },
        "extensions": { "$ref": "#/$defs/extensions" }
      }
    },
    "metric": {
      "type": "object",
      "required": ["id", "kind"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "kind": { "const": "metric" },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "value": true,
        "label": { "type": "string" },
        "format": { "type": "string" },
        "delta": { "type": "number" },
        "trend": { "enum": ["up", "down", "flat"] },
        "data": { "type": "string" },
        "field": { "type": "string" },
        "theme": { "$ref": "#/$defs/themeRef" },
        "placement": { "$ref": "#/$defs/placement" },
        "accessibility": { "$ref": "#/$defs/accessibility" },
        "extensions": { "$ref": "#/$defs/extensions" }
      },
      "anyOf": [{ "required": ["value"] }, { "required": ["data", "field"] }]
    },
    "container": {
      "type": "object",
      "required": ["id", "kind", "views"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "kind": { "const": "container" },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "layout": { "$ref": "#/$defs/layout" },
        "views": {
          "type": "array",
          "items": { "$ref": "#/$defs/view" }
        },
        "theme": { "$ref": "#/$defs/themeRef" },
        "placement": { "$ref": "#/$defs/placement" },
        "accessibility": { "$ref": "#/$defs/accessibility" },
        "extensions": { "$ref": "#/$defs/extensions" }
      }
    },
    "native": {
      "type": "object",
      "required": ["id", "kind", "renderer", "spec"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "kind": { "const": "native" },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "renderer": { "type": "string" },
        "spec": true,
        "data": { "type": "string" },
        "placement": { "$ref": "#/$defs/placement" },
        "accessibility": { "$ref": "#/$defs/accessibility" },
        "extensions": { "$ref": "#/$defs/extensions" }
      }
    },
    "interaction": {
      "type": "object",
      "required": ["type", "source"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string" },
        "type": {
          "enum": [
            "hover",
            "select",
            "multi-select",
            "filter",
            "highlight",
            "cross-filter",
            "zoom",
            "pan",
            "drilldown",
            "parameter"
          ]
        },
        "source": { "type": "string" },
        "targets": {
          "type": "array",
          "items": { "type": "string" },
          "uniqueItems": true
        },
        "field": { "type": "string" },
        "parameter": { "type": "string" },
        "options": { "type": "object", "additionalProperties": true },
        "extensions": { "$ref": "#/$defs/extensions" }
      }
    },
    "security": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "network": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "allow": {
              "type": "array",
              "items": { "type": "string" },
              "uniqueItems": true
            }
          }
        },
        "files": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "roots": {
              "type": "array",
              "items": { "type": "string" },
              "uniqueItems": true
            }
          }
        },
        "externalAssets": { "type": "boolean", "default": false },
        "unsafeHtml": { "type": "boolean", "default": false },
        "scripts": { "type": "boolean", "default": false },
        "extensions": { "$ref": "#/$defs/extensions" }
      }
    },
    "rendererCapability": {
      "type": "object",
      "required": ["name"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string" },
        "version": { "type": "string" },
        "visualKinds": {
          "type": "array",
          "items": { "type": "string" },
          "uniqueItems": true
        },
        "formats": {
          "type": "array",
          "items": { "enum": ["svg", "png", "pdf", "html", "json"] },
          "uniqueItems": true
        },
        "interactions": {
          "type": "array",
          "items": { "type": "string" },
          "uniqueItems": true
        },
        "features": {
          "type": "array",
          "items": { "type": "string" },
          "uniqueItems": true
        },
        "extensions": { "$ref": "#/$defs/extensions" }
      }
    }
  }
}
